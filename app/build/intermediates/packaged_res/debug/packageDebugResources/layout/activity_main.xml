<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TOP BAR -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#C7A4FF"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:elevation="6dp">

        <!-- EMPTY SPACE -->

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"/>

        <!-- TITLE -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Coach"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:gravity="center"/>

        <!-- LOGOUT ICON -->

        <ImageView
            android:id="@+id/btnLogout"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"/>
    </LinearLayout>

    <!-- MAIN CONTENT -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomNav"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="82sp"
            android:textAlignment="center"
            android:text="Welcome to Gym App"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginTop="5dp"/>

        <!-- IMAGE CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#161616"
            app:cardElevation="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_homeeeeeee"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>

        <!-- SUBTITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginLeft="22dp"
            android:text="Ask AI for diet, workout and motivation 💪"
            android:textColor="#BDBDBD"
            android:textSize="15sp"
            android:layout_marginTop="18dp"/>

        <!-- SPACE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- AI BUTTON -->

        <androidx.cardview.widget.CardView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="#D8BFFF"
            app:cardElevation="8dp">

            <Button
                android:id="@+id/btnAI"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="🤖"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- BOTTOM NAVIGATION -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_alignParentBottom="true"
        android:background="#111111"
        app:itemIconSize="22dp"
        app:itemIconTint="#D8BFFF"
        app:itemTextColor="#D8BFFF"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_menu"/>

</RelativeLayout>